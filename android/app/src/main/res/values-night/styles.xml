<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts. Encore is a dark-only app, so this is
         the same in both system modes rather than flashing white first. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/encore_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- Applied once the process is up: the window behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/encore_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/encore_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
