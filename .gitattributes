# Normalise line endings on checkin; check out with the platform's own.
* text=auto eol=lf

# Windows tooling expects CRLF in these.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary: never diffed, never line-ending-converted.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.wav       binary
*.mp3       binary
*.flac      binary
*.m4a       binary
*.onnx      binary
*.jar       binary
*.keystore  binary
*.jks       binary
*.ttf       binary
*.otf       binary

# Generated or vendored: keep them out of diffs and out of language stats.
pubspec.lock                    -diff linguist-generated
test/goldens/*.png              -diff linguist-generated
android/gradle/wrapper/**       linguist-vendored
ios/Runner.xcodeproj/**         -diff linguist-generated
macos/Runner.xcodeproj/**       -diff linguist-generated
