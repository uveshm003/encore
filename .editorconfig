# Editor defaults, so a checkout looks the same wherever it is opened.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
# dart format's own width. Set here so an editor's ruler agrees with CI.
max_line_length = 80

[*.py]
indent_size = 4
max_line_length = 88

[*.{kt,kts,gradle}]
indent_size = 4

[*.swift]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown; do not eat them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
